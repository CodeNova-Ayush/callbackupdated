# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Use https in production.
BETTER_AUTH_URL=http://localhost:3000
# Required by compose.yaml for the bundled Postgres.
POSTGRES_PASSWORD=
# Used when running the app outside compose.
DATABASE_URL=postgresql://callback:<POSTGRES_PASSWORD>@localhost:5432/callback
SEED_DEMO=false
# Required when SEED_DEMO=true.
SEED_DEMO_PASSWORD=
